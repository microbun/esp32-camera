# N16R8: 16 MB quad Flash + 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Logs go to UART0 (TTL connector), keeping native USB available to UVC.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Bulk uses the available Full-Speed USB bandwidth for larger JPEG frames.
CONFIG_TUSB_PRODUCT="GOOUUU OV2640 USB Camera"
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_UVC_MODE_BULK_CAM1=y
CONFIG_FRAMESIZE_VGA=y
CONFIG_UVC_CAM1_FRAMERATE=30
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=y
CONFIG_UVC_MULTI_FRAME_WIDTH_1=800
CONFIG_UVC_MULTI_FRAME_HEIGHT_1=600
CONFIG_UVC_MULTI_FRAME_FPS_1=30
CONFIG_UVC_MULTI_FRAME_WIDTH_2=1280
CONFIG_UVC_MULTI_FRAME_HEIGHT_2=720
CONFIG_UVC_MULTI_FRAME_FPS_2=15
CONFIG_UVC_MULTI_FRAME_WIDTH_3=320
CONFIG_UVC_MULTI_FRAME_HEIGHT_3=240
CONFIG_UVC_MULTI_FRAME_FPS_3=30
CONFIG_UVC_SUPPORT_TWO_CAM=n
