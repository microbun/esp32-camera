{
  "name": "GOOUUU ESP32-S3-CAM N16R8 (16 MB Flash, 8 MB PSRAM)",
  "vendor": "GOOUUU",
  "url": "https://www.espressif.com/en/products/socs/esp32-s3",
  "frameworks": ["espidf"],
  "connectivity": ["wifi", "bluetooth"],
  "build": {
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "hwids": [["0x303A", "0x1001"]]
  },
  "upload": {
    "flash_size": "16MB",
    "maximum_size": 16777216,
    "maximum_ram_size": 327680,
    "speed": 460800,
    "require_upload_port": true
  },
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": ["esp-builtin"],
    "openocd_target": "esp32s3.cfg"
  }
}
